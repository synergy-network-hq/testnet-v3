RestartSec=5
Environment=SYNERGY_SEED_SERVICE_SCRIPT=/opt/synergy/testnet-v3/seed-service/seed_service.py
Environment=SYNERGY_SEED_SERVICE_SCRIPT_SHA256=8a88c3e2e1198100694cb3981f86d0c34f79aad3e1c255394690ac9862b8b7f9
