# Generated dedicated Testnet-v3 service. Prepare-only; no legacy unit is modified.
[Unit]
Description=Synergy Testnet-v3 dedicated seed3
After=network-online.target
Wants=network-online.target
ConditionPathIsRegular=/etc/synergy/testnet-v3/seed-services/seed3.genesis.json
ConditionPathIsRegular=/etc/synergy/testnet-v3/seed-services/seed3.json

[Service]
Type=simple
DynamicUser=yes
StateDirectory=synergy-testnet-v3-seed-seed3
WorkingDirectory=/var/lib/synergy-testnet-v3-seed-seed3
Environment=SYNERGY_RELEASE_ID=synergy-testnet-v3
Environment=SYNERGY_CHAIN_ID=1266
Environment=SYNERGY_NETWORK_ID=synergy-testnet-v3
Environment=SYNERGY_GENESIS_FILE=/etc/synergy/testnet-v3/seed-services/seed3.genesis.json
