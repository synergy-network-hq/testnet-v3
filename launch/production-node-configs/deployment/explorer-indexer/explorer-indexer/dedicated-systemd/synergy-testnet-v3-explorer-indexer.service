# Generated dedicated Testnet-v3 service. Prepare-only; no legacy unit is modified.
[Unit]
Description=Synergy Testnet-v3 dedicated explorer-indexer
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/synergy/testnet-v3/explorer-indexer/genesis.json
ConditionPathExists=/etc/synergy/testnet-v3/explorer-indexer/node.toml

[Service]
Type=simple
DynamicUser=yes
StateDirectory=synergy-testnet-v3-explorer-indexer
WorkingDirectory=/var/lib/synergy-testnet-v3-explorer-indexer
Environment=SYNERGY_RELEASE_ID=synergy-testnet-v3
Environment=SYNERGY_CHAIN_ID=1266
Environment=SYNERGY_NETWORK_ID=synergy-testnet-v3
Environment=SYNERGY_GENESIS_FILE=/etc/synergy/testnet-v3/explorer-indexer/genesis.json
Environment=SYNERGY_GENESIS_SHA256=ee554c197a878cbfdaf7d470a0274ab2859a7a0c14c87e425908a69c6fbb51cf
Environment=SYNERGY_GENESIS_HASH=c087b6b7c1aae6f13f4c0140ba9a230a12dea0fa52b611777dee69369457de3d
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/synergy/testnet-v3/explorer-indexer/runtime.env
Environment=SYNERGY_CONFIG_FILE=/etc/synergy/testnet-v3/explorer-indexer/node.toml
Environment=SYNERGY_CONFIG_SHA256=e4552a52dab8bf791818acb24f65f2717f3e74b2770e50c70b6af257f41449b5
ExecStart=/opt/synergy/testnet-v3/bin/synergy-release-guard
