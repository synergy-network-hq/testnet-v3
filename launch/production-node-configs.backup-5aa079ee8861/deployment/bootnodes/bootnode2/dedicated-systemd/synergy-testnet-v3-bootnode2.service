# Generated dedicated Testnet-v3 service. Prepare-only; no legacy unit is modified.
[Unit]
Description=Synergy Testnet-v3 dedicated bootnode2
After=network-online.target
Wants=network-online.target
ConditionPathIsRegular=/etc/synergy/testnet-v3/bootnode2/genesis.json
ConditionPathIsRegular=/etc/synergy/testnet-v3/bootnode2/node.toml

[Service]
Type=simple
DynamicUser=yes
StateDirectory=synergy-testnet-v3-bootnode2
WorkingDirectory=/var/lib/synergy-testnet-v3-bootnode2
Environment=SYNERGY_RELEASE_ID=synergy-testnet-v3
Environment=SYNERGY_CHAIN_ID=1266
Environment=SYNERGY_NETWORK_ID=synergy-testnet-v3
Environment=SYNERGY_GENESIS_FILE=/etc/synergy/testnet-v3/bootnode2/genesis.json
Environment=SYNERGY_GENESIS_SHA256=ee554c197a878cbfdaf7d470a0274ab2859a7a0c14c87e425908a69c6fbb51cf
Environment=SYNERGY_GENESIS_HASH=c087b6b7c1aae6f13f4c0140ba9a230a12dea0fa52b611777dee69369457de3d
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/synergy/testnet-v3/bootnode2/runtime.env
Environment=SYNERGY_CONFIG_FILE=/etc/synergy/testnet-v3/bootnode2/node.toml
Environment=SYNERGY_CONFIG_SHA256=d2827ce19377a21eef7e8f0271091f9ce290c1a370eb1dca0a751e6a0cd6ec61
ExecStart=/opt/synergy/testnet-v3/bin/synergy-release-guard
