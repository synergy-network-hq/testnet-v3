# Chain 1266 incarnation 5 — single_authority_v1 authority environment
# Installed at /etc/synergy/chain1266/authority-node-01.env (0640 root:synergy)

SYNERGY_PROJECT_ROOT=/var/lib/synergy/node
SYNERGY_CONFIG_PATH=/var/lib/synergy/node/config/node.toml
SYNERGY_DATA_PATH=/var/lib/synergy/node/data
SYNERGY_GENESIS_FILE=/var/lib/synergy/node/config/genesis.json

SYNERGY_CHAIN_ID=1266
SYNERGY_NETWORK_ID=synergy-testnet-v3
SYNERGY_VALIDATOR_ADDRESS=synv11n57gc4h9tnt3c78crncx46hnlg9vz8eu4lu

SYNERGY_VALIDATOR_MLDSA65_CONSENSUS_PRIVATE_KEY_FILE=/var/lib/synergy/keys/mldsa65-consensus/private.key

# Public ingress stays closed for the private launch.
SYNERGY_RPC_BIND_ADDRESS=127.0.0.1:5640
SYNERGY_METRICS_BIND=127.0.0.1:6030
SYNERGY_ENABLE_METRICS=false

SYNERGY_LOG_LEVEL=info
RUST_BACKTRACE=1
