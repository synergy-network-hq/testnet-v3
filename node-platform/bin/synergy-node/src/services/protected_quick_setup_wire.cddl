; Fee-free initial enrollment v3. Actual protocol fee is zero on all networks.
; No sponsor, payer, fee cap, funding, deposit or financial nonce is present.
; The three leading bstr slots are EXACT canonical FeeFreeEnrollmentIntent
; JSON, canonical action CBOR, and empty bytes. D/P admission signatures bind
; the encrypted envelope and bounded resources in the dedicated profile.
; D/P/R initial proofs and AccountBinding remain mandatory for that role set.
fee-free-enrollment-commit = [28673, bstr, bstr, bstr .size 0]
dp-enrollment-reveal = [
  28674, bstr, bstr, bstr, [dp-pop-d, dp-pop-p],
  bstr .size 65, bstr .size 32
]
dp-pop-d = [1, 1, uint, 0, bstr .size 32, bstr .size 64, bstr .size 4627]
dp-pop-p = [1, 1, uint, 1, bstr .size 32, bstr .size 64, bstr .size 4627]
dp-role-d = [0, bstr .size 32, uint, 1, bstr .size 2592, null, null]
dp-role-p = [1, bstr .size 32, uint, 1, bstr .size 2592, null, null]
dp-policy = {
  0: 2, 1: bstr .size 32, 2: bstr .size 20, 3: uint,
  4: {0: [0, 1]}, 5: [dp-role-d, dp-role-p],
  6: bstr .size 65, 7: bstr .size 32, 8: 7200, 10: 0
}
dp-enrollment = {
  0: 2, 1: bstr .size 32, 2: bstr .size 20, 3: bstr .size 65,
  4: dp-policy, 5: bstr .size 32, 6: bstr .size 32, 7: uint,
  8: uint, 9: bstr .size 16
}
; D/P pure ML-DSA-87 context AEGIS.ACCOUNT.ENROLL.DP.V1.
; Digest SHA3-512("AEGIS/ACCOUNT-ENROLL-DP/v1" || DCBOR(dp-enrollment)).
; EIP-712 ownership binds SHA3-256(same domain || DCBOR(dp-enrollment)).
; Commit remains SHA3-256(DCBOR(dp-enrollment) || bytes32(salt)).
