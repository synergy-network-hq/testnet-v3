{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synergy.network/network-manifest/v1",
  "title": "network-manifest",
  "type": "object",
  "required": [
    "schema_version",
    "chain_id",
    "network_id",
    "genesis_hash",
    "protocol_versions",
    "roles_hash",
    "etdag_hash",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "chain_id": {
      "type": "integer",
      "minimum": 1
    },
    "network_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "genesis_hash": {
      "$ref": "#/$defs/hash"
    },
    "protocol_versions": {
      "type": "object"
    },
    "roles_hash": {
      "$ref": "#/$defs/hash"
    },
    "etdag_hash": {
      "$ref": "#/$defs/hash"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
