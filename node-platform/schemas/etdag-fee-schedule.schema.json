{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synergy.network/etdag-fee-schedule/v1",
  "title": "etdag-fee-schedule",
  "type": "object",
  "required": [
    "schema_version",
    "base_fee",
    "per_byte_fee"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "base_fee": {
      "type": "integer",
      "minimum": 0
    },
    "per_byte_fee": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
