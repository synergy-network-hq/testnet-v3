{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synergy.network/role-profile/v1",
  "title": "role-profile",
  "type": "object",
  "required": [
    "schema_version",
    "role",
    "plane",
    "capabilities",
    "ports"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "role": {
      "type": "string"
    },
    "plane": {
      "enum": [
        "public",
        "operator",
        "consensus_candidate"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "ports": {
      "type": "object"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
