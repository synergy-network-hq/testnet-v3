{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synergy.network/validator-membership/v1",
  "title": "validator-membership",
  "type": "object",
  "required": [
    "schema_version",
    "epoch",
    "validators",
    "authorization_root"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "validators": {
      "type": "array",
      "minItems": 1
    },
    "authorization_root": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
