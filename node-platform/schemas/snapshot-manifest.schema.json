{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synergy.network/snapshot-manifest/v1",
  "title": "snapshot-manifest",
  "type": "object",
  "required": [
    "schema_version",
    "height",
    "state_root",
    "chunks",
    "finality_proof",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "state_root": {
      "$ref": "#/$defs/hash"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "finality_proof": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
