    },
    {
      "type": "stat",
      "title": "Average Peer Count",
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(synergy_p2p_peers_connected{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer\"} or synergy_peer_count{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer\"} or synergy_validator_peer_count{job=\"synergy-validators\"})",
          "legendFormat": "peers",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      },
      "description": "Average peer count across nodes that expose peer metrics. Higher is usually healthier."
    },
    {
      "type": "stat",
      "title": "Average Block Time",
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "300 / clamp_min(max(delta(synergy_chain_height{job=\"synergy-validators\"}[5m])), 1)",
          "legendFormat": "seconds/block",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "description": "Average seconds per block over the selected window. Lower is faster. This answers: \"How quickly are blocks being created?\" Formula for the 5 minute panel: 300 / max(delta(synergy_chain_height{job=\"synergy-validators\"}[5m])). The denominator is clamped to 1 so a stalled window is visible instead of blank."
    },
    {
      "type": "table",
      "title": "Node Metrics Roster",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer|node_exporter_private|node_exporter_public_roles|prometheus|private-qrpc-probes|public-http-probes|public-tcp-probes\"}",
          "legendFormat": "Up",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "synergy_chain_height{job=\"synergy-validators\"} or synergy_chain_height{job=~\"synergy-relayers|synergy-rpc-gateways|synergy-explorer|synergy-archive-validators\"}",
          "legendFormat": "Block Height",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "synergy_p2p_peers_connected{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer\"} or synergy_peer_count{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer\"} or synergy_validator_peer_count{job=\"synergy-validators\"}",
          "legendFormat": "Peer Count",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "synergy_sync_in_progress{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer\"}",
          "legendFormat": "Syncing",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "time() - timestamp(up{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer|node_exporter_private|node_exporter_public_roles|prometheus|private-qrpc-probes|public-http-probes|public-tcp-probes\"})",
          "legendFormat": "Last Seen",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "label_replace(up{job=~\"synergy-validators|synergy-relayers|synergy-archive-validators|synergy-rpc-gateways|synergy-explorer|node_exporter_private|node_exporter_public_roles|prometheus|private-qrpc-probes|public-http-probes|public-tcp-probes\"} * 0, \"status_note\", \"Configured target\", \"instance_label\", \".*\")",
          "legendFormat": "Notes/Status",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance_label",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "instance_label": "Node Name",
              "role": "Role",
              "instance": "Target",
              "host": "Host",
              "job": "Job",
              "Value #A": "Up",
              "Value #B": "Block Height",
              "Value #C": "Peer Count",
              "Value #D": "Syncing",
              "Value #E": "Last Seen",
              "status_note": "Notes/Status",
              "Value #F": "Notes/Status Value"
            },
            "indexByName": {
              "Node Name": 0,
              "Role": 1,
              "Target": 2,
              "Up": 3,
              "Block Height": 4,
              "Peer Count": 5,
              "Syncing": 6,
              "Last Seen": 7,
              "Notes/Status": 8,
              "Host": 9,
              "Job": 10,
              "Notes/Status Value": 11
            },
            "excludeByName": {
              "Notes/Status Value": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "N/A"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "description": "Roster table with Node Name, Role, Target, Up, Block Height, Peer Count, Syncing, Last Seen, and Notes/Status. Missing role-specific metrics are displayed as N/A."
    },
