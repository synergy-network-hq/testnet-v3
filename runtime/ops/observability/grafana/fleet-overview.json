      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "description": "Highest reported block height across the reporting testnet nodes. Unit: blocks."
    },
    {
      "type": "stat",
      "title": "Validator Height Difference",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(synergy_chain_height{job=\"synergy-validators\"}) - min(synergy_chain_height{job=\"synergy-validators\"})",
          "legendFormat": "difference",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
