<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.synergynetwork.archive-snapshot-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON3__</string><string>__BIN_ROOT__/synergy-archive</string><string>serve</string>
    <string>--root</string><string>__APP_ROOT__</string>
    <string>--publish-root</string><string>__PUBLISH_ROOT__</string>
    <string>--runtime</string><string>__BIN_ROOT__/synergy-archive-validator-node</string>
    <string>--aegis</string><string>__BIN_ROOT__/aegis-pqvm</string>
    <string>--bind</string><string>__SNAPSHOT_API_BIND__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__BIN_ROOT__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__LOG_ROOT__/snapshot-api.out.log</string>
  <key>StandardErrorPath</key><string>__LOG_ROOT__/snapshot-api.err.log</string>
</dict>
</plist>
