<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>network.synergy.archive-health-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/Shared/Synergy/archive-validator/bin/archive-health-supervisor.sh</string>
    <string>--once</string>
  </array>
  <key>UserName</key>
  <string>root</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/Shared/Synergy/archive-validator/logs/archive-health-supervisor.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/Synergy/archive-validator/logs/archive-health-supervisor.err.log</string>
</dict>
</plist>
