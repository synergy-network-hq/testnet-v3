<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>network.synergy.archive-catalog-revalidator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/Shared/Synergy/archive-validator/bin/revalidate-public-catalog.sh</string>
  </array>
  <key>UserName</key>
  <string>synergynode</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/Shared/Synergy/archive-validator/logs/catalog-revalidator.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/Synergy/archive-validator/logs/catalog-revalidator.err.log</string>
</dict>
</plist>
