# Non-secret validator VPN coordinator defaults for packaged desktop installs.
# The public key is used to verify signed peer snapshots from the coordinator.

SYNERGY_VALIDATOR_VPN_COORDINATOR_URL=https://vpn-coordinator.synergy-network.io
SYNERGY_VALIDATOR_VPN_ENROLLMENT_SIGNATURE_MODE=challenge-sha256
SYNERGY_VALIDATOR_VPN_COORDINATOR_PUBLIC_KEY=ed25519:0tA5eh5BHCPxXFUlHtb5+GOJFPqLhmnxDOqli39Y+iI=
# Public verifier for signed coordinator-managed Innernet membership receipts.
# The coordinator must configure the matching private key before cutover.
SYNERGY_INNERNET_COORDINATOR_PUBLIC_KEY=ed25519:0tA5eh5BHCPxXFUlHtb5+GOJFPqLhmnxDOqli39Y+iI=
