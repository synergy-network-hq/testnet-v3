server {
  listen 80;
  listen [::]:80;
  server_name vpn-coordinator.synergy-network.io;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/letsencrypt;
    default_type "text/plain";
    try_files $uri =404;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name vpn-coordinator.synergy-network.io;

  ssl_certificate /etc/letsencrypt/live/vpn-coordinator.synergy-network.io/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vpn-coordinator.synergy-network.io/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  access_log /var/log/nginx/vpn-coordinator.access.log;
  error_log /var/log/nginx/vpn-coordinator.error.log;

  location = /health {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:47895/health;
    include proxy_params;
  }

  # Innernet onboarding is the only supported v19 enrollment path.
  location = /v1/invite {
    limit_except POST { deny all; }
    proxy_pass http://127.0.0.1:47895/v1/invite;
    include proxy_params;
  }

  location = /v1/mesh/confirm {
    limit_except POST { deny all; }
    proxy_pass http://127.0.0.1:47895/v1/mesh/confirm;
    include proxy_params;
  }

  location = /v1/mesh/status {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:47895/v1/mesh/status;
    include proxy_params;
  }

  location = /v1/mesh/transports {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:47895/v1/mesh/transports;
    include proxy_params;
  }

  location = /v1/mesh/transports/current {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:47895/v1/mesh/transports/current;
    include proxy_params;
  }

  location = /v1/mesh/transports/refresh {
    limit_except POST { deny all; }
    proxy_pass http://127.0.0.1:47895/v1/mesh/transports/refresh;
    include proxy_params;
  }

  # Old clients receive an explicit HTTP 410 after cutover.
  location = /api/validator-vpn/snapshots/latest {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:47895/api/validator-vpn/snapshots/latest;
    include proxy_params;
  }

  location / {
    return 404;
  }
}
