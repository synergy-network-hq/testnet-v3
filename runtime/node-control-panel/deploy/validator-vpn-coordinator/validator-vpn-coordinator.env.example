# Synergy Validator VPN Coordinator production env.
# Install as /etc/synergy/validator-vpn-coordinator.env.
# Do not commit real token or signing-key values.

SYNERGY_RESOURCE_ROOT=/opt/synergy/node-control-panel
SYNERGY_APP_DATA_DIR=/var/lib/synergy/node-control-panel
SYNERGY_CONTROL_SERVICE_DISABLE_LOCAL_AGENT=true

SYNERGY_VALIDATOR_VPN_COORDINATOR_URL=https://vpn-coordinator.synergy-network.io
SYNERGY_VALIDATOR_VPN_ENROLLMENT_SIGNATURE_MODE=challenge-sha256

# The coordinator invokes the real non-interactive `innernet-server add-peer`
# command only. The server's administration surface must remain local to this
# host; the coordinator returns a one-time TOML invitation to the authenticated
# enrollment caller and deletes its local copy immediately after reading it.
SYNERGY_INNERNET_SERVER_COMMAND=/usr/local/bin/innernet-server
SYNERGY_INNERNET_INTERFACE=sy-vpn
SYNERGY_INNERNET_VALIDATOR_CIDR=validators
SYNERGY_INNERNET_RELAYER_CIDR=relayers
# These are Innernet-only address plans. They must not overlap the retired
# static 10.69.0.0/16 WireGuard network or any host/service subnet.
SYNERGY_INNERNET_VALIDATOR_ADDRESS_CIDR=10.70.10.0/24
SYNERGY_INNERNET_RELAYER_ADDRESS_CIDR=10.70.20.0/24
SYNERGY_INNERNET_CONFIG_DIR=/etc/innernet-server
SYNERGY_INNERNET_DATA_DIR=/var/lib/innernet-server
SYNERGY_INNERNET_INVITE_DIR=/var/lib/synergy/node-control-panel/innernet-invites
# innernet-server prompts without this value. Use a positive integer followed
# by exactly one of s, m, h, d, or w; the coordinator defaults to 30m.
SYNERGY_INNERNET_INVITE_EXPIRES=30m
# Keep false until every existing validator/relayer is re-enrolled, has an
# Innernet handshake, and the old 10.69 static VPN is retired.
SYNERGY_INNERNET_MIGRATION_READY=false
SYNERGY_INNERNET_MIGRATION_ID=replace-with-approved-innernet-migration-id

# Required by the systemd unit and protected coordinator/admin endpoints.
SYNERGY_VALIDATOR_VPN_COORDINATOR_TOKEN=replace-with-generated-bearer-token

# Required before relayer registration, bootstrap import, or public validator enrollment can
# generate a signed peer snapshot. The signing key is an Ed25519 32-byte seed.
SYNERGY_VALIDATOR_VPN_COORDINATOR_SIGNING_KEY=ed25519:replace-with-32-byte-seed-base64

# Publish this non-secret public key in client/install packages as
# SYNERGY_VALIDATOR_VPN_COORDINATOR_PUBLIC_KEY so agents can verify snapshots.
SYNERGY_VALIDATOR_VPN_COORDINATOR_PUBLIC_KEY=ed25519:replace-with-32-byte-public-key-base64

# Dedicated Innernet membership-receipt key. The public key is bundled with
# installers as SYNERGY_INNERNET_COORDINATOR_PUBLIC_KEY. It may reuse the
# coordinator key only when the same approved key rotation policy covers both.
SYNERGY_INNERNET_COORDINATOR_SIGNING_KEY=ed25519:replace-with-32-byte-seed-base64
SYNERGY_INNERNET_COORDINATOR_PUBLIC_KEY=ed25519:replace-with-32-byte-public-key-base64

# Optional static allowlist. Leave unset to use setup identity validation plus the public
# 50,000 SNRG live stake gate in the enrollment HTTP handler.
# SYNERGY_VALIDATOR_VPN_ELIGIBLE_VALIDATORS=
