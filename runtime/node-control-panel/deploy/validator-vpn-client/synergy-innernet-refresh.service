[Unit]
Description=Refresh Synergy Innernet peer membership
After=network-online.target synergy-innernet.service
Requires=synergy-innernet.service
ConditionPathExists=/etc/innernet/sy-vpn.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/synergy-innernet-refresh.sh
TimeoutStartSec=110
Nice=10

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/innernet /etc/hosts /var/lib/innernet /run/lock -/run/wireguard -/var/run/wireguard
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
