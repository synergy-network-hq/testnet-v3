[Unit]
Description=Lock down Synergy validator public service surface
After=network-online.target ufw.service synergy-innernet.service
Wants=network-online.target synergy-innernet.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/synergy-validator-public-surface-lockdown.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
