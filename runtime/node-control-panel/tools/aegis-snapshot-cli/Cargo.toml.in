[package]
name = "synergy-aegis-snapshot-cli"
version = "19.0.0"
edition = "2021"
publish = false

[dependencies]
aegis-pqvm = { path = "@@AEGIS_PQVM_PATH@@" }
base64 = "0.22"
pqrust-traits = { path = "@@AEGIS_PQVM_PATH@@/vendor/pqcrypto-traits" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.10"
