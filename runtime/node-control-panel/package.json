{
  "name": "synergy-node-control-panel",
  "version": "20.0.0",
  "description": "Synergy Node Control Panel",
  "author": "Synergy Network <support@synergy-network.io>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/electron/dev-electron.mjs",
    "dev:desktop": "node scripts/electron/dev-desktop.mjs",
    "build": "vite build",
    "build:control-service": "cargo build --manifest-path control-service/Cargo.toml --bin control-service --release --no-default-features",
    "build:electron": "npm run prepare:native-deps && npm run test:runtime-version-alignment && npm run build && npm run build:control-service && node scripts/electron/prepare-runtime.mjs",
    "dist:electron": "npm run build:electron && electron-builder --config electron-builder.yml",
    "build:sidecars": "bash scripts/build-sidecars.sh",
    "build:bundle-prep": "bash scripts/release/build-bundle-prep.sh",
    "release:extract-validator-assignments": "node scripts/release/extract-validator-assignment-map.mjs",
    "release:validator-distribution": "node scripts/release/prepare-validator-distribution.mjs",
    "preview": "vite preview",
    "test:uiux-revamp": "node scripts/qa/control-panel-uiux-revamp-check.mjs",
    "test:visualizations": "node --test scripts/qa/control-panel-v18-visualization-test.mjs",
    "test:macos-updater": "node scripts/qa/macos-updater-policy-test.cjs",
    "test:bond-stake": "node scripts/qa/bond-stake-envelope-test.cjs",
    "test:operation-catalog": "node scripts/qa/operation-catalog-test.mjs",
    "test:terminal-ipc": "node scripts/qa/terminal-ipc-test.cjs",
    "test:operations": "npm run test:operation-catalog && npm run test:operation-terminal && npm run test:operation-pty && npm run test:operation-tooltips && npm run test:terminal-ipc",
    "test:operation-terminal": "node --test scripts/qa/operation-terminal-test.mjs",
    "test:operation-pty": "node --test scripts/qa/operation-pty-bridge-test.mjs",
    "test:operation-tooltips": "node --test scripts/qa/operation-tooltip-test.mjs",
    "prepare:native-deps": "node scripts/electron/prepare-native-dependencies.mjs",
    "test:terminal-pty": "npm run prepare:native-deps && node scripts/qa/pty-manager-test.cjs",
    "test:protocol-policy": "node --test scripts/qa/protocol-policy-test.mjs",
    "test:runtime-version-alignment": "node scripts/qa/runtime-version-alignment-test.mjs",
    "test:archive-health": "bash scripts/qa/archive-health-supervisor-test.sh && bash scripts/qa/archive-snapshot-worker-test.sh && bash scripts/qa/archive-catalog-uploader-install-test.sh && bash scripts/qa/archive-catalog-uploader-repair-test.sh",
    "test:onboarding-contracts": "node scripts/qa/onboarding-deterministic-contract-test.cjs",
    "test:onboarding-monitor": "node --test scripts/qa/control-panel-v18-onboarding-monitor-test.mjs",
    "test:validator-distribution": "node --test scripts/qa/validator-distribution-contract-test.mjs",
    "test:validator-assignment": "node --test scripts/qa/validator-assignment-contract-test.mjs",
    "test:selected-node-persistence": "node scripts/qa/control-panel-selected-node-persistence-test.mjs",
    "test:wallet-null-safety": "node --test scripts/qa/wallet-account-null-safety-test.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.101.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-geo": "^3.1.1",
    "electron-updater": "^6.8.3",
    "geoip-lite": "^2.0.1",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "remark-gfm": "^4.0.1",
    "topojson-client": "^3.1.0",
    "wagmi": "^2.19.5",
    "world-atlas": "^2.0.2",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.1.0",
    "electron-builder": "^26.8.1",
    "vite": "^7.3.0",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "viem": {
      "ws": "8.21.0"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.59.0"
  },
  "homepage": "https://synergy-network.io"
}
