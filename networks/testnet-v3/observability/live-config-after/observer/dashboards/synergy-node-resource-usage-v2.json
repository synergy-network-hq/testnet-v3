        "definition": "query_result(sort(max by (node_type) (up{job=~\"synergy-observer|synergy-validators|synergy-archive|synergy-rpc-gateway|synergy-explorer-indexer|node_exporter|node_exporter_public|synergy-qrpc-probes|synergy-http-probes|synergy-bootstrap-probes\",node_type!=\"\"})))",
