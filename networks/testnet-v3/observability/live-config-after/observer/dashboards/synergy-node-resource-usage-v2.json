        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(max by (environment) (synergy_inventory_node_info))",
        "query": "query_result(max by (environment) (synergy_inventory_node_info))",
        "regex": "/environment=\"([^\"]+)\"/",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
