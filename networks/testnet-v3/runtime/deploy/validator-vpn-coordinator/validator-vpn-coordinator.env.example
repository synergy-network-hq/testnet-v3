# Copy to /etc/default/validator-vpn-coordinator if local overrides are needed.
# The service units keep the production defaults explicit and do not require
# this file to exist.
INNERNET_SERVER_BIN=/usr/bin/innernet-server
INNERNET_CONFIG_DIR=/etc/innernet-server
INNERNET_DATA_DIR=/var/lib/innernet-server
INNERNET_INVITE_ROOT=/var/lib/validator-vpn-coordinator/invitations
# Required by innernet-server add-peer to avoid its invite-expiry prompt.
# Keep this conservative; 30m is the production recommendation.
SYNERGY_INNERNET_INVITE_EXPIRES=30m
