{
  "description": "Block production cadence, finalization latency, mempool pressure, view changes, and gas price.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Block Production Rate by Validator",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * rate(synergy_chain_height{job=\"synergy-validators\"}[5m])",
          "legendFormat": "{{instance_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "description": "Per-validator block-height movement in blocks per minute. Val5 remains visible even when it is down, quarantined, or producing zero blocks."
    },
    {
      "type": "timeseries",
      "title": "Block Finalization Latency (seconds, p50 and p95 and p99)",
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(synergy_block_finalization_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(synergy_block_finalization_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(synergy_block_finalization_seconds_bucket[5m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "target",
          "expr": "vector(2)",
          "legendFormat": "target (2s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "description": "Block Finalization Latency (seconds, p50 and p95 and p99) for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "timeseries",
      "title": "Mempool Pending Transactions",
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(synergy_mempool_pending_transactions{job=~\"synergy-validators|synergy-relayers\"} or (up{job=~\"synergy-validators|synergy-relayers\"} * 0)) or synergy_mempool_size",
          "legendFormat": "{{instance_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Mempool Pending Transactions for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "timeseries",
      "title": "Suggested Gas Price",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(synergy_mempool_gas_price_nwei{job=~\"synergy-validators|synergy-relayers\"} or (up{job=~\"synergy-validators|synergy-relayers\"} * 0)) or synergy_gas_price_nwei",
          "legendFormat": "{{instance_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Suggested Gas Price for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "timeseries",
      "title": "View Changes per Second",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(synergy_view_change_total[5m])",
          "legendFormat": "{{instance_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "View Changes per Second for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "timeseries",
      "title": "Nodes Currently Syncing",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "synergy_sync_in_progress",
          "legendFormat": "{{instance_label}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "max": 1,
          "min": 0
        }
      },
      "description": "Nodes Currently Syncing for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "timeseries",
      "title": "qRPC Request Duration p95 by Method",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(synergy_rpc_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "description": "qRPC Request Duration p95 by Method for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "timeseries",
      "title": "qRPC Request Errors by Method",
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(synergy_rpc_call_errors_total[5m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "qRPC Request Errors by Method for Synergy Testnet operations. Check units and legend for interpretation."
    },
    {
      "type": "stat",
      "title": "Average Block Time",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "300 / clamp_min(max(delta(synergy_chain_height{job=\"synergy-validators\"}[5m])), 1)",
          "legendFormat": "seconds/block",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "description": "Average seconds per block over the selected window. Lower is faster. This answers: \"How quickly are blocks being created?\" Formula for the 5 minute panel: 300 / max(delta(synergy_chain_height{job=\"synergy-validators\"}[5m])). The denominator is clamped to 1 so a stalled window is visible instead of blank."
    },
    {
      "type": "stat",
      "title": "Average Block Time, 15m",
      "id": 10,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "900 / clamp_min(max(delta(synergy_chain_height{job=\"synergy-validators\"}[15m])), 1)",
          "legendFormat": "seconds/block",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "description": "Average seconds per block over the last 15 minutes. Formula: 900 / max(delta(synergy_chain_height{job=\"synergy-validators\"}[15m])). Lower is faster."
    },
    {
      "type": "stat",
      "title": "Current Block Production Rate",
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * max(rate(synergy_chain_height{job=\"synergy-validators\"}[5m]))",
          "legendFormat": "blocks/min",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "description": "Current canonical block production rate in blocks per minute using the highest validator block-height slope. Higher means blocks are being produced faster."
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
