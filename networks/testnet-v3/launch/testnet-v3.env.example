SYNERGY_RELEASE_ID=testnet-v3
SYNERGY_CHAIN_ID=1266
SYNERGY_NUMERIC_NETWORK_ID=1266
SYNERGY_NETWORK_ID=synergy-testnet-v3
SYNERGY_GENESIS_FILE=/etc/synergy/testnet-v3/genesis.json
SYNERGY_CONFIG_FILE=/etc/synergy/testnet-v3/node.toml
SYNERGY_DATA_DIR=/var/lib/synergy/testnet-v3
SYNERGY_LOG_DIR=/var/log/synergy/testnet-v3

# Set only in the deployment environment. Do not commit private values.
SYNERGY_NODE_ID=<GENERATE_FRESH_NODE_ID>
SYNERGY_VALIDATOR_ADDRESS=<FRESH_VALIDATOR_ADDRESS_IF_APPLICABLE>
