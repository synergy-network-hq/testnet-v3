  "operational_blockers": [
    {
      "id": "aivm_general_synq_execution",
      "status": "resolved",
      "evidence": "runtime/synergy-aivm/docs/readiness/CURRENT_STATUS.md",
      "reason": "Testnet-v3 stateful SynQ IR v2 executes constructors and general calls with canonical calldata, caller/value and block context, persistent storage, events, PQ verification, manifest-gated host calls, native transfers, nested contract calls, and atomic rollback."
    },
    {
      "id": "synq_genesis_contract_deployment",
      "status": "resolved",
      "evidence": "genesis-contracts/README.md",
      "reason": "The focused AIVM integration test deploys all eight native SynQ contracts, exercises representative stateful and cross-contract calls, restores serialized state, and proves deterministic state-root and receipt replay."
    },
    {
      "id": "operational_posy_v2_2_engine_convergence",
      "status": "blocked",
      "evidence": "launch/POSY_V2_2_ALIGNMENT_AUDIT.md",
      "reason": "The inherited ProofOfSynergy/DualQuorumConsensus startup path is now disabled and fails closed. The typed height-context, VC/QC/TC, durable SafetyHalt, signer-journal, and protected ETDAG implementation is not yet wired as the sole cross-process operational coordinator, so validator signing remains intentionally unavailable."
    },
    {
      "id": "wallet_etdag_sealing",
      "status": "blocked",
      "evidence": "launch/POSY_V2_2_ALIGNMENT_AUDIT.md",
      "reason": "The external Wallet platforms still contain legacy plaintext/Aegis submission methods and are not integrated with the native ETDAG sealer."
    },
    {
      "id": "etdag_target_context_and_ingress_keys",
      "status": "blocked",
      "evidence": "launch/POSY_V2_2_ALIGNMENT_AUDIT.md",
      "reason": "The certified H+3 context, strict certificate validation, public ML-KEM registry schema, append-only store, and discovery RPC are implemented. Operational package issuance/propagation and the final public records from the separate identity workstream are not yet bound into genesis or installed."
    },
    {
      "id": "security_performance_genesis_launch_qualification",
      "status": "blocked",
      "evidence": "launch/launch-readiness.json",
      "reason": "Security v7, full regression/chaos/replay, deterministic external-input genesis, reproducible release, required performance profiles, and the 10,000-block soak remain incomplete."
    }
  ]
